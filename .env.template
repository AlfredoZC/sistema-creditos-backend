# CORS: comma-separated origins allowed to call the API (read in main.ts via
# resolveCorsOrigins). Default when unset: http://localhost:4200 (dev frontend).
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=tokensecreto123


# WhatsApp bot (outbound template notifications + conversational debt bot)
#
# Adapter selection. 'mock' = deterministic in-memory fake (safe default —
# no real sends, integration tests depend on it); 'meta' = Meta Cloud API
# (production). Any other value fails fast at boot (factory throws on first
# injection). With 'mock', the Meta adapter is NEVER constructed, so the
# credential vars below are only read when WHATSAPP_PROVIDER=meta.
WHATSAPP_PROVIDER=mock
# Meta system-user access token (WhatsApp Cloud API). Bearer auth for every
# send and template-submit call. Required when WHATSAPP_PROVIDER=meta.
WHATSAPP_TOKEN=
# Phone number ID (numeric) of the WABA's sending number, from Meta App
# Dashboard -> WhatsApp -> API Setup. Required when WHATSAPP_PROVIDER=meta.
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret — the key for the x-hub-signature-256 HMAC-SHA256 the
# webhook verifies over the RAW request body (verify-then-parse). MUST match
# the app secret of the Meta app that owns the WABA.
WHATSAPP_APP_SECRET=
# Webhook verify token: the GET handshake echoes hub.challenge only when
# hub.verify_token matches this value (constant-time compare). MUST match the
# value configured in the Meta webhook subscription.
WHATSAPP_VERIFY_TOKEN=
# WhatsApp Business Account ID (numeric). Target of template submissions
# (POST /{WABA_ID}/message_templates). Required when WHATSAPP_PROVIDER=meta.
WHATSAPP_WABA_ID=
# Controller path of the public webhook (defaults to 'whatsapp/webhook' ->
# POST/GET /api/whatsapp/webhook). Keep a non-empty value: an empty string is
# NOT treated as unset by the controller (`'' ?? default` stays ''), which
# would register the webhook at /api/. Configure this same path in the Meta
# webhook subscription.
WHATSAPP_WEBHOOK_PATH=whatsapp/webhook


CLOUD_NAME_CLOUDINARY=
API_KEY_CLOUDINARY=
API_SECRET_CLOUDINARY=
FOLDER_CLOUDINARY=
CLOUDINARY_PRESET=


# Recordatorios automaticos de cuotas. El job diario resuelve las plantillas
# por nombre; ambas deben existir en message_templates con status 'approved' e
# is_active=true (el seed las crea). Cada una debe declarar exactamente tres
# placeholders: {{1}} nombre del paciente, {{2}} numero de cuota, {{3}} fecha.
REMINDER_TEMPLATE_DUE_SOON=payment_reminder
REMINDER_TEMPLATE_OVERDUE=payment_overdue
# Tope de recordatorios despachados por corrida y por tipo. Protege al
# proveedor cuando hay mora acumulada: lo que no entra se manda en la corrida
# siguiente, porque un recordatorio ya enviado nunca se repite.
REMINDER_MAX_PER_RUN=200
