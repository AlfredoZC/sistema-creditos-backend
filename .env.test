DB_HOST=localhost
DB_PORT=5439
DB_NAME=db_creditos_test
DB_USERNAME=root
DB_PASSWORD=rootpassword
JWT_SECRET=test-secret

# WhatsApp mock set: required for AppModule boot in integration specs.
# WHATSAPP_PROVIDER=mock guarantees the Meta adapter is never constructed
# (spec "Mock provider isolation"); the secret/token/path values are test
# doubles used by webhook signature specs.
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=test-token
WHATSAPP_PHONE_NUMBER_ID=test-phone-number-id
WHATSAPP_APP_SECRET=test-app-secret
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_WABA_ID=test-waba-id
WHATSAPP_WEBHOOK_PATH=whatsapp/webhook
